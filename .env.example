# ============================================================
# Environment Variables Template
# Copy to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# --- LLM Providers ---
# Add the ones you use. LiteLLM proxy handles routing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- LiteLLM Proxy (runs locally via Docker on WSL2) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=

# --- Langfuse Observability (self-hosted via Docker on WSL2) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://pranavsrivastava.com

# --- Email (for contact form, add later) ---
RESEND_API_KEY=
